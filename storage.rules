rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize(maxMB) {
      return request.resource.size <= maxMB * 1024 * 1024;
    }

    // ── User Avatars ──────────────────────────────────────────────────────────
    match /avatars/{uid}/{fileName} {
      allow read: if isAuth();
      allow write: if isOwner(uid)
        && isImage()
        && isValidSize(5);
      allow delete: if isOwner(uid);
    }

    // ── Journal Attachments ───────────────────────────────────────────────────
    match /journal/{uid}/{entryId}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && (isImage() || request.resource.contentType.matches('audio/.*'))
        && isValidSize(20);
      allow delete: if isOwner(uid);
    }

    // ── Workout Media ─────────────────────────────────────────────────────────
    match /workouts/{uid}/{sessionId}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isImage()
        && isValidSize(10);
      allow delete: if isOwner(uid);
    }

    // ── Court Shared Media ────────────────────────────────────────────────────
    match /courts/{courtId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && isImage()
        && isValidSize(8);
      allow delete: if isAuth();
    }
  }
}
