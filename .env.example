# Firebase (these go in GoogleService-Info.plist / google-services.json)
# This file is for reference only — never commit real credentials

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-app-id
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# RevenueCat (for subscription management)
REVENUECAT_API_KEY_IOS=your-ios-key
REVENUECAT_API_KEY_ANDROID=your-android-key

# Gemini AI (Google AI Studio — used for "Ask Cleopatra" in journal)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# App Check (reCAPTCHA / Device Check)
APP_CHECK_DEBUG_TOKEN=your-debug-token
